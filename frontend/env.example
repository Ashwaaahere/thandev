# Vercel Environment Variables
# Copy this to .env.local for local development

# Backend API URL (will be your Fly.io app URL)
NEXT_PUBLIC_API_BASE=https://your-app-name.fly.dev

# Example for local development
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# NextAuth Configuration
# Generate a secure secret with: openssl rand -base64 32
# IMPORTANT: Variable name is NEXTAUTH_SECRET (no underscore between NEXT and AUTH)
NEXTAUTH_SECRET=your_generated_secret_here

# NextAuth URL - MUST be set for production
# For Vercel deployment, use your Vercel app URL
NEXTAUTH_URL=https://thandev.vercel.app

# For local development, use:
# NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (for NextAuth)
# Support both naming conventions:
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET (recommended, matches GitHub OAuth app)
# OR GITHUB_ID / GITHUB_SECRET (legacy, also supported)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# Alternative (also works):
# GITHUB_ID=your_github_oauth_app_client_id
# GITHUB_SECRET=your_github_oauth_app_client_secret
